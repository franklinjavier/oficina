      ],
      "meta": {
        "kind": "grok-bot-template",
        "role": "orchestrator",
        "fictional": true
      },
      "docs": "Fictional Grok Bot snapshot. Copy profile fields into Bot actions → Edit Profile. Treat skill pointers as enable-list hints, not private skill dumps. Create routines from the templates only after you fill local sources. This item never includes conversation history, learned memory, credentials, or factory.db.",
      "categories": [
        "grok-bot",
        "template",
        "orchestrator"
      ],
      "type": "registry:item"
    }
  ]
