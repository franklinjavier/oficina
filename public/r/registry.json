          "target": "~/oficina/bots/orchestrator/SNAPSHOT.md"
        },
        {
          "path": "registry/orchestrator/profile.json",
          "type": "registry:file",
          "target": "~/oficina/bots/orchestrator/profile.json"
        },
        {
          "path": "registry/orchestrator/avatar.svg",
          "type": "registry:file",
          "target": "~/oficina/bots/orchestrator/avatar.svg"
        },
        {
          "path": "registry/orchestrator/skills.json",
          "type": "registry:file",
          "target": "~/oficina/bots/orchestrator/skills.json"
        },
        {
          "path": "registry/orchestrator/skills/route-work.md",
          "type": "registry:file",
          "target": "~/oficina/bots/orchestrator/skills/route-work.md"
        },
        {
          "path": "registry/orchestrator/routines/morning-brief.template.json",
          "type": "registry:file",
          "target": "~/oficina/bots/orchestrator/routines/morning-brief.template.json"
        },
        {
          "path": "registry/orchestrator/routines/weekly-review.template.json",
          "type": "registry:file",
          "target": "~/oficina/bots/orchestrator/routines/weekly-review.template.json"
